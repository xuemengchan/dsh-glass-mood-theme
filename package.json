{
  "name": "dsh-glass-mood-theme",
  "version": "1.53.2",
  "description": "DeepSeek Harness 网页界面的玻璃拟态主题：随情绪切换的调色板、每状态一段 MP4/WebM 壁纸、逐面板玻璃、不透明的内容表面、随内容变化的光线与压暗、按压形变，并应答减弱透明 / 增强对比度 / 减弱动效。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "glassmorphism"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "安装说明.md",
    "test"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  }
}
